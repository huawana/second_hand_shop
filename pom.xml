<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.example</groupId>
    <artifactId>springboot3</artifactId>
    <version>1.0-SNAPSHOT</version>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Phase 1：2.4.3 → 3.3.5
             选 3.3.5 的理由：
               1) 官方支持 Java 17~22，本机 JDK 22 直接可用，不需要额外装 JDK
               2) 与 Spring Cloud 2023.0.x / Spring Cloud Alibaba 2023.0.x 对齐，
                  后续 Phase 11 拆微服务、接入 Nacos/Sentinel/Seata 不需要再动父版本
               3) 是 Boot 3.3 的最后一个补丁版，稳定
             注意：Boot 3.3 是 javax → jakarta 的分水岭，所有 javax.servlet / javax.validation
             必须迁到 jakarta.*，否则启动即 ClassNotFoundException。 -->
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <properties>
        <!-- Boot 3 的基线是 Java 17。用 release 而不是 source/target：
             release 会同时约束字节码版本与 API 可见性，避免误用高版本 JDK 的新 API。 -->
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- 第三方组件版本（不交给 Boot 管理的部分统一在这里收口） -->
        <mybatis-spring-boot.version>3.0.4</mybatis-spring-boot.version>
        <jjwt.version>0.12.6</jjwt.version>
    </properties>

    <dependencies>
        <!-- ==================== Web / 视图 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!-- ==================== 持久层 ==================== -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>${mybatis-spring-boot.version}</version>
        </dependency>
        <dependency>
            <!-- 注意坐标变了：Boot 2.x 时代是 mysql:mysql-connector-java（已废弃），
                 现在归到 com.mysql:mysql-connector-j，版本由 Boot 统一管理。
                 作用域 runtime：代码里只通过 JDBC 接口访问，不直接依赖其 API。 -->
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- 说明：原来声明的 com.alibaba:druid 在整个项目里零引用（没有配置类、没有 StatFilter），
             属于「为了用连接池而声明连接池」。Phase 1 直接移除，
             连接池改用 Boot 默认的 HikariCP（由 mybatis starter 传递引入）。
             Phase 9 做 SQL 监控时，再按需加回 druid-spring-boot-3-starter。 -->

        <!-- ==================== 参数校验 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ==================== 认证与授权（Phase 1） ==================== -->
        <dependency>
            <!-- Spring Security 6：认证（AuthenticationManager）/ 授权（AuthorizationFilter）
                 / 密码编码器（BCryptPasswordEncoder）/ CSRF 防护 / Filter 链 -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <!-- 实现类只在运行期需要：接口 jjwt-api 编译时可见，运行时由 impl 提供 -->
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!-- JWT 的 payload 需要 JSON 序列化，交给 Jackson 实现 -->
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== 自定义 Starter（Phase 1 收尾，考点 16） ==================== -->
        <dependency>
            <!-- 文件上传自动配置：注入 FileStorage 即可用，无需任何 @Configuration。
                 本地构建需先安装：.hermes/mvn.sh -f oss-spring-boot-starter/pom.xml install
                 （或用 .hermes/build-all.sh 一步完成） -->
            <groupId>com.example</groupId>
            <artifactId>oss-spring-boot-starter</artifactId>
            <version>1.0.0</version>
        </dependency>

        <!-- ==================== 中间件（后续 Phase 的落点，先保持声明） ==================== -->
        <dependency>
            <!-- Phase 3：商品缓存 / 分布式锁 / 限流 -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <!-- Phase 8：IM 私聊（原项目遗留的 chat_records / lxy_mate 表正好用上） -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- ==================== 工具 ==================== -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================== 测试 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <!-- devtools 不打包进产物 -->
                        <exclude>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-devtools</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
