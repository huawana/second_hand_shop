<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="shop.admin.mapper.CartMapper">
    <insert id="addUserCartById">
        insert into lxy_cart(id,created_at) values(#{id},Now())
    </insert>
    <update id="updateCartProducts">
        update lxy_cart set products = #{products} where id = #{id}
    </update>
    <select id="getCartById" resultType="shop.admin.Bean.Cart">
        select * from lxy_cart where id=#{id}
    </select>
    <select id="getCarts" resultType="shop.admin.Bean.Cart">
        select * from lxy_cart
    </select>
</mapper>